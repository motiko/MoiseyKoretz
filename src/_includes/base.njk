{%- set L = languages[lang] -%}
{%- set stem = page.url | langStem -%}
{%- set isHome = stem == "index.html" -%}
<!DOCTYPE html>
<html lang="{{ lang }}"{% if L.dir == "rtl" %} dir="rtl"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#e6dccb" media="(prefers-color-scheme: light)" data-scheme="light">
  <meta name="theme-color" content="#14110e" media="(prefers-color-scheme: dark)" data-scheme="dark">
  {#- applyTheme("light" | "dark" | ""): sets <html data-theme> and points the theme-color metas at it ("" follows the device). Runs before first paint with the saved choice. #}
  <script>(function(){function a(t){var r=document.documentElement;if(t)r.setAttribute("data-theme",t);else r.removeAttribute("data-theme");document.querySelectorAll('meta[name="theme-color"]').forEach(function(m){var s=m.getAttribute("data-scheme");m.media=t?(s==t?"all":"not all"):"(prefers-color-scheme: "+s+")";});}window.applyTheme=a;try{var t=localStorage.getItem("theme");if(t=="light"||t=="dark")a(t);}catch(e){}})();</script>
  <title>{{ title | safe }}</title>
  <meta name="description" content="{{ description | safe }}">
{%- if noindex %}
  <meta name="robots" content="noindex">
{%- else %}
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
{%- for code, other in languages %}
  <link rel="alternate" hreflang="{{ code }}" href="{{ page.url | langUrl(code) | absoluteUrl(site.url) }}">
{%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ page.url | langUrl('ru') | absoluteUrl(site.url) }}">
  <meta property="og:type" content="{{ 'website' if isHome else 'article' }}">
  <meta property="og:site_name" content="{{ L.name }}">
  <meta property="og:locale" content="{{ L.ogLocale }}">
{%- for code, other in languages %}{% if code != lang %}
  <meta property="og:locale:alternate" content="{{ other.ogLocale }}">
{%- endif %}{% endfor %}
  <meta property="og:title" content="{{ title | safe }}">
  <meta property="og:description" content="{{ description | safe }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:image" content="{{ '/images/moisey.jpg' | absoluteUrl(site.url) }}">
  <meta property="og:image:width" content="544">
  <meta property="og:image:height" content="848">
  <meta name="twitter:card" content="summary_large_image">
{%- endif %}
{%- if isHome and lang == "ru" %}
  {#- Ownership checks for Google Search Console and Bing Webmaster Tools: keep them, or the site loses its verification. #}
  <meta name="google-site-verification" content="UJHwGY3pAnQxWMze5L7ngxQ-n1YTEIX1L_DnHTy21pA">
  <meta name="msvalidate.01" content="A15004D1DBF39A5B9D0B45FAF6188345">
{%- endif %}
{%- if isHome and not noindex %}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"{{ L.name }}","birthDate":"1908","deathDate":"1984","url":"{{ page.url | absoluteUrl(site.url) }}","image":"{{ '/images/moisey.jpg' | absoluteUrl(site.url) }}"}</script>
{%- endif %}
{#- The body text face for the page's script: Literata Cyrillic or Latin, Noto Serif Hebrew. #}
  <link rel="preload" href="{{ root }}fonts/{{ {ru: 'literata-cyrillic-opsz-normal', en: 'literata-latin-opsz-normal', he: 'noto-serif-hebrew-hebrew-wght-normal'}[lang] }}.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="icon" href="{{ root }}favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ root }}site.css?v={{ assets.siteCss }}">
{%- if headStyle %}
  <style>
{% include "styles/" + headStyle %}  </style>
{%- endif %}
</head>
<body>
  <a class="skip" href="#{{ skipTarget }}">{{ skipLabel }}</a>
  <div class="sheet">

    <header>
      <a class="brand" href="{{ brandHref }}">{{ L.home }}</a>
      <nav aria-label="{{ L.sections }}">
{%- for item in nav %}
        <a href="{{ navPrefix }}{{ item.href }}"{% if item.key == section %} aria-current="page"{% endif %}>{{ item.label if lang == "ru" else item[lang] }}</a>
{%- endfor %}
      </nav>
      <div class="tools">
        <details class="pick theme" hidden>
          <summary aria-label="{{ L.theme.label }}">{% include "icons/theme.svg" %}</summary>
          <ul>
            <li><button type="button" data-theme-choice="light">{% include "icons/sun.svg" %}<span class="name">{{ L.theme.light }}</span></button></li>
            <li><button type="button" data-theme-choice="dark">{% include "icons/moon.svg" %}<span class="name">{{ L.theme.dark }}</span></button></li>
            <li><button type="button" data-theme-choice="system">{% include "icons/theme.svg" %}<span class="name">{{ L.theme.system }}</span></button></li>
          </ul>
        </details>
{%- if not noindex %}
        <details class="pick langs" dir="ltr">
          <summary aria-label="{{ L.language }}: {{ L.label }}">{% include "flags/" + lang + ".svg" %}<span class="code">{{ lang | upper }}</span></summary>
          <ul>
{%- for code, other in languages %}
{%- if code == lang %}
            <li><span aria-current="true" lang="{{ code }}" translate="no">{% include "flags/" + code + ".svg" %}<span class="code">{{ code | upper }}</span> <span class="name">{{ other.label }}</span></span></li>
{%- else %}
            <li><a href="{{ root }}{{ page.url | inLang(code) }}" lang="{{ code }}" hreflang="{{ code }}" translate="no">{% include "flags/" + code + ".svg" %}<span class="code">{{ code | upper }}</span> <span class="name">{{ other.label }}</span></a></li>
{%- endif %}
{%- endfor %}
          </ul>
        </details>
{%- endif %}
      </div>
      <script>(function(){var n=document.querySelector("header nav"),a=n&&n.querySelector("[aria-current]");if(!n)return;function f(){n.classList.toggle("scrolled",Math.abs(n.scrollLeft)>0)}n.addEventListener("scroll",f,{passive:true});n.addEventListener("focusin",function(e){var r=e.target.getBoundingClientRect(),b=n.getBoundingClientRect(),m=32;if(r.width>b.width-2*m)n.scrollLeft+=(r.left+r.right-b.left-b.right)/2;else if(r.left<b.left+m)n.scrollLeft-=b.left+m-r.left;else if(r.right>b.right-m)n.scrollLeft+=r.right-b.right+m;});if(a&&n.scrollWidth>n.clientWidth){var r=a.getBoundingClientRect(),b=n.getBoundingClientRect();n.scrollLeft+=document.dir=="rtl"?r.right-b.right+24:r.left-b.left-24;}f();})();(function(){function c(k,x){document.querySelectorAll("details.pick[open]").forEach(function(d){if(d==x)return;d.open=false;if(k)d.querySelector("summary").focus();});}document.addEventListener("click",function(e){c(0,e.target.closest("details.pick"));});document.addEventListener("keydown",function(e){if(e.key=="Escape")c(1);});addEventListener("pageshow",function(){c();});})();(function(){var d=document.querySelector("details.theme");if(!d)return;d.hidden=false;function m(){var t=document.documentElement.getAttribute("data-theme")||"system";d.querySelectorAll("[data-theme-choice]").forEach(function(b){b.setAttribute("aria-pressed",b.getAttribute("data-theme-choice")==t);});}m();d.addEventListener("click",function(e){var b=e.target.closest("[data-theme-choice]");if(!b)return;var t=b.getAttribute("data-theme-choice");applyTheme(t=="system"?"":t);try{if(t=="system")localStorage.removeItem("theme");else localStorage.setItem("theme",t);}catch(x){}m();d.open=false;d.querySelector("summary").focus();});})();</script>
    </header>

    <main id="{{ mainId }}"{% if mainClass %} class="{{ mainClass }}"{% endif %}>{{ content | safe }}</main>
  </div>
{%- if 'class="gallery"' in content %}
  <dialog class="lightbox" aria-label="{{ L.gallery.label }}">
    <figure>
      <img alt="" decoding="async">
      <figcaption><span class="lightbox-caption"></span> <span class="lightbox-count" dir="ltr"></span></figcaption>
    </figure>
    <button class="lightbox-prev" type="button" aria-label="{{ L.gallery.prev }}"></button>
    <button class="lightbox-next" type="button" aria-label="{{ L.gallery.next }}"></button>
    <form method="dialog"><button class="lightbox-close" aria-label="{{ L.gallery.close }}"></button></form>
  </dialog>
  <script src="{{ root }}gallery.js?v={{ assets.galleryJs }}" defer></script>
{%- endif %}
</body>
</html>
